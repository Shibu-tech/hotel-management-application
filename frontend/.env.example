# ==============================================================================
# Multi-Tenant Hotel Platform — Next.js Frontend Configuration
# ==============================================================================

# Public Application URL (your frontend domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Java Spring Boot Backend API Base URL
# Local: http://localhost:8080/api
# Deployed Render Backend: https://hotel-management-application-4v49.onrender.com/api
NEXT_PUBLIC_API_URL=https://hotel-management-application-4v49.onrender.com/api

# Development-only Quick Access helper (NEVER set to true in production; ignored when NODE_ENV=production)
NEXT_PUBLIC_DEV_QUICK_ACCESS=false
