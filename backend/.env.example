# ==============================================================================
# Spring Boot Backend Environment Variables Template
# Copy to local environment / deployment secret manager — NEVER commit real values
# ==============================================================================

PORT=8080

# PostgreSQL Connection (e.g. local PostgreSQL or Neon with sslmode=require)
DATABASE_URL=jdbc:postgresql://localhost:5432/hotel_management
DATABASE_USERNAME=replace_with_db_username
DATABASE_PASSWORD=replace_with_db_password

# Hibernate DDL mode: use 'validate' in production, 'update' only for local scratch DBs
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# JWT Signing Secret (minimum 32 UTF-8 bytes / 256-bit random secret)
JWT_SECRET=replace_with_at_least_32_byte_cryptographically_random_secret
JWT_EXPIRATION_MS=86400000

# Cookie Security (Set AUTH_COOKIE_SECURE=true in HTTPS production)
AUTH_COOKIE_NAME=hotel_auth_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# Exact Frontend Origins Allowed for CORS (comma-separated, no wildcards)
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Base URL
FRONTEND_BASE_URL=http://localhost:3000

# Optional Development Profile Only (NEVER enable in production)
# SPRING_PROFILES_ACTIVE=dev
# DEV_SEED_ADMIN_EMAIL=admin@example.local
# DEV_SEED_ADMIN_PASSWORD=replace_for_local_dev_only
